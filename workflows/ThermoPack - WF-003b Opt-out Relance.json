    },
    {
      "parameters": {
        "toRecipients": "alice.durand@thermopack.example",
        "subject": "=Relance stoppee — {{ $('Valider Params').first().json.reference_offre }} ({{ $json.entreprises?.nom || 'Client' }})",
        "bodyContent": "=Le client <b>{{ $json.entreprises?.nom || 'N/A' }}</b> ne souhaite plus recevoir de relances pour l'offre <b>{{ $json.reference_offre }}</b> ({{ $json.montant_ht }} EUR HT).\n\n<br><br>L'offre a ete marquee comme <b>relance stoppee</b>. Aucun email de suivi ne sera envoye.\n\n<br><br><i>Action automatique — WF-003b</i>",
