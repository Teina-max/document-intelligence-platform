    {
      "id": "63b44d17-0231-4ec7-ae88-4df9ddbfed5c",
      "name": "Commandes avec Offre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -752,
        1104
      ],
      "parameters": {
        "method": "GET",
        "url": "https://{ANON_SUPABASE_REF}.supabase.co/rest/v1/commandes?select=id,offre_id,reference_commande,reference_offre,montant_ht&reference_offre=not.is.null&limit=5000",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "{ANON_SUPABASE_CRED_ID}",
          "name": "Supabase-ThermoPack"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Rapprochement offres/commandes\n// - Lie les commandes aux offres par reference_offre\n// - Calcule le taux de transformation par offre\n// - Seuil 1% pour classification\n// - Statut offre = transformee dans tous les cas\n// - Type commande = egale/partielle/superieure\n\nconst offres = $('Offres en Attente').all().map(i => i.json);\nconst commandes = $('Commandes avec Offre').all().map(i => i.json);\n\nconst results = [];\n\nfor (const offre of offres) {\n  const ref = offre.reference_offre;\n  if (!ref) continue;\n\n  // Trouver les commandes liees a cette offre\n  const cmdsLiees = commandes.filter(c =>\n    c.offre_id === offre.id ||\n    (c.reference_commande && c.reference_offre === ref)\n  );\n\n  // Calculer le total des commandes\n  let totalCommandes = 0;\n  const cmdIds = [];\n  for (const cmd of cmdsLiees) {\n    totalCommandes += parseFloat(cmd.montant_ht) || 0;\n    cmdIds.push(cmd.id);\n  }\n\n  const montantOffre = parseFloat(offre.montant_ht) || 0;\n  const ancienStatut = offre.statut;\n\n  // Classification — seuil 1%\n  let typeRapprochement = 'non_transformee';\n  let nouveauStatut = offre.statut;\n\n  if (cmdsLiees.length > 0 && totalCommandes > 0) {\n    const ratio = totalCommandes / montantOffre;\n    if (ratio < 0.99) {\n      typeRapprochement = 'partielle';\n    } else if (ratio > 1.01) {\n      typeRapprochement = 'superieure';\n    } else {\n      typeRapprochement = 'egale';\n    }\n    // Statut offre = transformee dans tous les cas\n    nouveauStatut = 'transformee';\n  }\n\n  if (nouveauStatut === ancienStatut && typeRapprochement === 'non_transformee') continue;\n\n  results.push({\n    json: {\n      offre_id: offre.id,\n      reference_offre: ref,\n      montant_offre: montantOffre,\n      total_commandes: totalCommandes,\n      nb_commandes: cmdsLiees.length,\n      type_rapprochement: typeRapprochement,\n      ancien_statut: ancienStatut,\n      nouveau_statut: nouveauStatut,\n      ecart: Math.round((totalCommandes - montantOffre) * 100) / 100,\n      taux_transformation: montantOffre > 0 ? Math.round((totalCommandes / montantOffre) * 100) : 0,\n      cmd_ids: cmdIds\n    }\n  });\n}\n\nif (results.length === 0) {\n  return [{ json: { _no_changes: true } }];\n}\n\nreturn results;"
      },
      "id": "02c85802-a77d-4990-99ff-ebd20212ce54",
      "name": "Calculer Rapprochements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        1008
      ],
      "notes": "Compare chaque offre avec ses commandes liees.\nClassifie: egale (±1%), partielle (<99%), superieure (>101%).\nStatut offre = transformee dans tous les cas."
    },
