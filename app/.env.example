# Supabase — create a dedicated project at https://supabase.com for this repo
# ❗ Never reuse a production project: scripts/seed-demo-data.ts wipes tables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# Anthropic — Claude Vision for OCR (prompt v2.1 in scripts/prompts/)
ANTHROPIC_API_KEY=sk-ant-your-key

# n8n — self-hosted workflows (OCR ingestion + rapprochement offre/commande)
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/ocr-ingest
N8N_RAPPROCHEMENT_URL=https://n8n.example.com/webhook/rapprochement
N8N_WEBHOOK_SECRET=shared-secret-used-to-sign-requests

# Optional — Outlook OAuth2 (email relance sending). See docs/templates-relance.md
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_SENDER_EMAIL=
